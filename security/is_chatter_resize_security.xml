<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Chaque utilisateur ne voit et ne modifie que ses propres réglages -->
    <record id="is_chatter_resize_rule_user" model="ir.rule">
        <field name="name">Réglages du chatter : uniquement les siens</field>
        <field name="model_id" ref="model_is_chatter_resize"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
