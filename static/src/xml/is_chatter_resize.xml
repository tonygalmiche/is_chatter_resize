<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Bouton masquer / afficher le chatter, à droite de la barre du haut (à côté du pager) -->
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button t-if="this.isChatterActif"
                        type="button"
                        class="btn btn-secondary o_is_chatter_resize_toggle ms-1"
                        t-att-title="this.isChatterState.masque ? 'Afficher le chatter' : 'Masquer le chatter'"
                        t-on-click="() => this.isChatterBasculer()">
                    <!-- Odoo 20 : icônes « oi » (data-icon), pleine = chatter affiché, creuse = masqué -->
                    <i class="oi oi-fw" role="img" data-icon="chat_bubble"
                       t-attf-class="{{ this.isChatterState.masque ? '' : 'oi-filled' }}"/>
                </button>
            </t>
        </xpath>
    </t>

</templates>
